# Copy to deploy/deploy.env (gitignored) and fill in for your VPS.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   $EDITOR deploy/deploy.env
#   ./scripts/deploy-sync-server.sh

# SSH target (Tailscale MagicDNS name or 100.x.x.x address).
DEPLOY_HOST=example.ts.net
DEPLOY_USER=your-ssh-user

# Build: auto (default), zigbuild, cross (Docker on deploy host), or remote (compile on VPS).
# BUILD_STRATEGY=auto: Apple Silicon deploy host + x86_64 VPS → zigbuild; otherwise → cross.
# BUILD_STRATEGY=auto

# Rust triple. Leave unset to auto-detect from `uname -m` on the VPS.
# DEPLOY_TARGET=x86_64-unknown-linux-gnu
# DEPLOY_TARGET=aarch64-unknown-linux-gnu

# Paths on the VPS (native install, no Docker).
DOJJO_INSTALL_BIN=/opt/dojjo/bin
DOJJO_DATA_DIR=/var/lib/dojjo
DATABASE_URL=sqlite:///var/lib/dojjo/data.db

# HTTP: bind only on the Tailscale IPv4 address so the service is not on the public NIC.
# Leave empty to use `tailscale ip -4` on the VPS at deploy time.
# DOJJO_LISTEN=

# Client-visible origin for JJ API + smart HTTP Git (no trailing slash, no path).
# Defaults to http://${DEPLOY_HOST}:3000 when unset.
DOJJO_PUBLIC_URL=http://example.ts.net:3000

# Logging (systemd EnvironmentFile).
RUST_LOG=info,sync_server=info

# Client: dojjo init --api-base "${DOJJO_PUBLIC_URL}/api"
# Git remotes from the API: ${DOJJO_PUBLIC_URL}/git/<dojo-id>.git
