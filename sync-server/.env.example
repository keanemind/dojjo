# If unset, the server uses sqlite://<this crate>/data.db (see data.db in .gitignore).
# DATABASE_URL=sqlite:///absolute/path/to/data.db
#
# Smart HTTP Git remotes: http(s)://host[:port] with no path or trailing slash.
# Omit for local/e2e (clients get file:// paths under DOJJO_DATA_DIR).
# DOJJO_PUBLIC_URL=http://127.0.0.1:3000
#
# Before building sync-server (sqlx::query!), from repo root: ./scripts/init-sync-server-db.sh
